{
  "name": "inspiration.tengmesk.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inspiration — a gallery of UI recreations, component libraries and design resources, published from tengmesk/webdesigninspo.",
  "scripts": {
    "fetch": "node scripts/fetch-inspo.mjs",
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "build:preview": "npm run sync && PREVIEW=1 astro build --outDir dist-preview && node ../scripts/relativize.mjs dist-preview && node scripts/preview-fix.mjs dist-preview",
    "check": "astro check",
    "og": "node scripts/og.mjs",
    "shots": "node scripts/shots.mjs",
    "weights": "node scripts/weights.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.5",
    "marked": "^18.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "~5.9.0"
  }
}

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found" description="That page is not in the gallery." nav="none" noindex>
  <div class="wrap nf">
    <span class="eyebrow">404</span>
    <h1>Not in the gallery.</h1>
    <p>The page you asked for does not exist here. Entries move only when the content repository renames them, so this link was probably never right.</p>
    <div class="ctas">
      <a class="btn btn--primary" href="/">Start at the top<span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="/components/">Browse components</a>
    </div>
  </div>
</Layout>
